# ── Phense Environment Configuration ────────────────────────────────────────
# Copy this file to .env and fill in values before running the server.
# Never commit .env to Git.

# App
APP_ENV=development           # development | production
APP_PORT=8000
LOG_LEVEL=info

# Open Topo Data (elevation API — no key required for public endpoint)
OPEN_TOPO_BASE_URL=https://api.opentopodata.org/v1/srtm30m

# Optional: Geocoding API (for reverse geocoding lat/lon → LGA name)
# If left blank, Phense falls back to the bundled nigeria_lgas.json lookup
GEOCODING_API_KEY=

# CORS — origins allowed to call the API (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
